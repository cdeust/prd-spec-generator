{
  "name": "ai-architect-mcp-spec",
  "version": "0.7.0",
  "description": "Deterministic PRD structure verification for Codex, backed by AI Architect MCP Spec.",
  "author": {
    "name": "Clement Deust",
    "email": "admin@ai-architect.tools",
    "url": "https://github.com/cdeust"
  },
  "homepage": "https://github.com/cdeust/ai-architect-mcp-spec",
  "repository": "https://github.com/cdeust/ai-architect-mcp-spec",
  "license": "MIT",
  "keywords": [
    "prd",
    "specification",
    "validation",
    "mcp",
    "codex"
  ],
  "skills": "./skills/",
  "mcpServers": {
    "prd-spec-verifier": {
      "command": "node",
      "args": [
        "mcp-server/index.js",
        "--profile",
        "verifier"
      ],
      "cwd": "."
    }
  },
  "interface": {
    "displayName": "AI Architect MCP Spec",
    "shortDescription": "Deterministic PRD structure checks",
    "longDescription": "Audit PRD sections and whole documents with deterministic Hard Output Rules and cross-section consistency checks.",
    "developerName": "Clement Deust",
    "category": "Developer Tools",
    "capabilities": [
      "Read"
    ],
    "websiteURL": "https://github.com/cdeust/ai-architect-mcp-spec",
    "defaultPrompt": [
      "Audit this PRD for structural violations.",
      "Validate this specification section."
    ]
  }
}
